doctype html
html lang="en"
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width, initial-scale=1'
    title= head_title
    javascript:
      try { const theme = localStorage.getItem('theme'); if (theme) document.documentElement.dataset.theme = theme; } catch {}
    meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)"
    meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)"
    = partial 'layouts/favicons'
    = stylesheet_link_tag :all
    = javascript_include_tag :all, defer: true
    = yield_content :head
    link href="https://padrinorb.com/blog.rss" rel="alternate" type="application/rss+xml" title="Blog - Padrino Ruby Web Framework"
  body class=page_classes
    = partial 'layouts/header'
    main.page
      = yield
    = partial 'layouts/footer'
