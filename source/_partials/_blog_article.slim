article.article
  h1.article__title= blog_article.title
  p.article__metadata
    time datetime=blog_article.date.strftime('%Y-%m-%d') = blog_article.date.strftime('%B %-d, %Y')
    - unless blog_article.data.author.nil?
      span &middot; #{blog_article.data.author}
    - categories(blog_article).each do |category|
      =< link_to category, category_path(category), class: 'article__category'

  = blog_article.body
  = partial '/_partials/issue_report'
