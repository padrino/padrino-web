h1 Posts in “#{category.gsub(",", "")}”

- if all_categories[category]
  ul.post-list
    - all_categories[category].each do |article|
      li.post-list__item
        = link_to article.title, article
        time datetime=article.date.strftime('%Y-%m-%d') = article.date.strftime('%B %-d, %Y')

= link_to '/categories/', class: 'arrow-link' do
  | All categories
  = icon(:arrow_right)
